# Скопируй этот файл в .env и заполни поля
# ──────────────────────────────────────────────────────────────────

# Токен бота (https://discord.com/developers/applications → Bot → Reset Token)
DISCORD_TOKEN=ваш_токен_сюда

# ID приложения (Developer Portal → General Information → Application ID)
CLIENT_ID=ваш_client_id_сюда

# ID единственного сервера (рекомендуется на хостинге)
# Если не задан и бот только на одном сервере — подставится сам.
# Без GUILD_ID на нескольких серверах поведение нестабильно.
GUILD_ID=id_вашего_сервера

# Кол-во монет за минуту в голосовом канале
FARM_RATE=10

# Запасные ID, если /setup ещё не запускали (приоритет у /setup)
OWNER_ID=
TRIGGER_CHANNEL_ID=
VOICE_CATEGORY_ID=
VERIFIED_ROLE_ID=
# Доп. роли после верификации через запятую
EXTRA_VERIFY_ROLES=

# Достижения (часовой пояс и каналы)
ACH_TIMEZONE=Europe/Moscow
ACH_GENERAL_CHANNEL_ID=
ACH_CHAT_CHANNEL_ID=
ACH_NEWBIE_ROLE_ID=
ACH_SECRET_PHRASE=сова на скакалке
ACH_EASTER_WORDS=эхолуна,звездныйчай,тихийпорт
